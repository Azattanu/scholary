# ============================================================
# Scholary — правила Apache для scholary.kz
# Работают только если в Plesk (Apache и nginx → «Обрабатывать
# статические файлы с помощью nginx») из списка расширений убраны
# htm и html. Иначе HTML отдаёт nginx и эти правила игнорируются.
# ============================================================

# 1) HTML не кэшируем: иначе обновления сайта не доезжают до тех,
#    кто уже заходил (хостинг по умолчанию ставит expires на 10 лет).
#    Статика (css/js/картинки) кэшируется надолго и обновляется через ?v=NN.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Expires
    Header set Pragma "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 2) Свои страницы ошибок вместо стандартных серверных
ErrorDocument 403 /error_docs/403.html
ErrorDocument 404 /error_docs/404.html
ErrorDocument 500 /error_docs/500.html
ErrorDocument 502 /error_docs/502.html
ErrorDocument 503 /error_docs/503.html

# 3) Не отдаём наружу служебные файлы, начинающиеся с точки
<IfModule mod_authz_core.c>
  <FilesMatch "^\.(?!well-known)">
    Require all denied
  </FilesMatch>
</IfModule>

# 4) Аналитика через свой домен: /ph/… уходит на PostHog через api/ph.php.
#    Иначе блокировщики рекламы режут часть событий и воронка врёт.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ph/(.*)$ /api/ph.php?p=$1 [QSA,L]
  # Вебхук ApiPay (оплата Kaspi): адрес прописан в кабинете apipay.kz
  RewriteRule ^kaspi/webhook/?$ /api/kaspi-webhook.php [L]
  # на случай, если папка с секретами когда-нибудь окажется внутри сайта
  RewriteRule ^private(/|$) - [F]
</IfModule>

# 5) Служебные подключаемые файлы бэкенда наружу не отдаём.
#    Сами по себе они ничего не печатают, но и открывать их незачем.
<IfModule mod_authz_core.c>
  <FilesMatch "^_.*\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

# 6) Ограничиваем, кто может встраивать сайт и куда он ходит.
#    frame-ancestors 'self' — защита от кликджекинга поверх X-Frame-Options.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# 7) HSTS: браузер запоминает, что на этот сайт можно ходить только по HTTPS,
#    и больше не делает первый незащищённый запрос (его можно перехватить).
#    Заголовок отдаём только по HTTPS — по HTTP он всё равно игнорируется.
#    includeSubDomains и preload сознательно НЕ ставим: сначала нужно
#    убедиться, что все поддомены (webmail, mail и т.п.) живут по HTTPS,
#    иначе они станут недоступны на год без возможности быстро откатить.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
